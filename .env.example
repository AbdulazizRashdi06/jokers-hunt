# Copy this file to .env.local. NEVER put these credentials in NEXT_PUBLIC_ variables.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_SERVICE_ROLE_KEY
GAME_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX
GAME_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHAR_HEX
# Your real domain after deployment. Used in printed QR URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
